# ==================================================
# DARUKAA.EARTH Frontend — Environment Variables
# ==================================================
# Copy to .env.local for local development.

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Mapbox public access token (REQUIRED for map to work)
# Create at: https://account.mapbox.com
# Restrict the token to your domain in production.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
